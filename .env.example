# Copy this file to .env and fill in real values before running.

PORT=3000

# JWT signing secret — a long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-this-to-a-long-random-string

# Encryption key used to encrypt location data (name, description, coordinates)
# at rest in the database. MUST be exactly 64 hex characters (32 bytes).
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# WARNING: if you lose this key, existing encrypted data cannot be recovered.
# Do not change it after you have real data in the database.
ENCRYPTION_KEY=

# The single admin code used to unlock Admin mode (edit/delete locations,
# manage categories). Only used to seed the admin account the very first
# time the server runs — after that, change it from inside the Admin panel.
ADMIN_CODE=changeme123
